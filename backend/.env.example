# Database (asyncpg for SQLAlchemy, plain psycopg URL for LangGraph checkpointer)
DATABASE_URL=postgresql+asyncpg://agents:agents@postgres:5432/agents
DATABASE_URL_PSYCOPG=postgresql://agents:agents@postgres:5432/agents

# LLM (planner + responder) — Groq is the default (free tier)
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini

# Web search
TAVILY_API_KEY=

# Email (SendGrid)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
# Comma-separated allowlist — the agent refuses to email anyone outside these
EMAIL_ALLOWLIST_DOMAINS=example.com
EMAIL_ALLOWLIST_ADDRESSES=

# Google Calendar OAuth
GOOGLE_CLIENT_SECRETS_PATH=secrets/credentials.json
GOOGLE_TOKEN_PATH=secrets/token.json
GOOGLE_CALENDAR_TIMEZONE=UTC

# Agent
MAX_AGENT_STEPS=6
